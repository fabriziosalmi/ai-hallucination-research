---
const { frontmatter } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Everything this page loads is first-party; 'unsafe-inline' is required
      because the layout keeps its stylesheet in an inline <style> block.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'"
    />
    <title>{frontmatter?.title || 'Phantom Dependency Squatting Research'}</title>
    <style>
      /* ArXiv 2046 UI/UX - Ultra Premium */
      :root {
        /* Colors */
        --bg: #ffffff;
        --fg: #111111;
        --accent: #2563eb;
        --accent-hover: #1d4ed8;
        --border: #e5e7eb;
        --muted: #6b7280;
        
        /* Typography */
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        --font-serif: 'Georgia', 'Merriweather', serif;
        --font-mono: 'Menlo', 'Monaco', 'Courier New', monospace;
        
        /* Layout */
        --max-w: 65ch;
        --spacing: 2rem;
      }
      
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0a0a0a;
          --fg: #ededed;
          --accent: #60a5fa;
          --accent-hover: #93c5fd;
          --border: #262626;
          --muted: #a3a3a3;
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-serif);
        line-height: 1.7;
        color: var(--fg);
        background-color: var(--bg);
        margin: 0;
        padding: 0;
        font-size: 1.125rem;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      main {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: var(--spacing) 1.5rem;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-sans);
        font-weight: 700;
        line-height: 1.2;
        margin-top: 2.5em;
        margin-bottom: 1em;
        color: var(--fg);
        letter-spacing: -0.02em;
      }

      h1 {
        font-size: 2.5rem;
        margin-top: 1em;
        margin-bottom: 0.5em;
      }

      h2 { font-size: 1.875rem; border-bottom: 1px solid var(--border); padding-bottom: 0.3em; }
      h3 { font-size: 1.5rem; }

      p {
        margin-top: 0;
        margin-bottom: 1.5em;
      }

      a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s ease, color 0.2s ease;
      }

      a:hover {
        color: var(--accent-hover);
        border-bottom-color: var(--accent-hover);
      }

      pre {
        background-color: rgba(128, 128, 128, 0.05);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1.25rem;
        overflow-x: auto;
        font-family: var(--font-mono);
        font-size: 0.875em;
        line-height: 1.5;
        margin-bottom: 1.5em;
      }

      code {
        font-family: var(--font-mono);
        background-color: rgba(128, 128, 128, 0.08);
        padding: 0.2em 0.4em;
        border-radius: 4px;
        font-size: 0.9em;
      }

      pre code {
        background-color: transparent;
        padding: 0;
        border-radius: 0;
      }

      blockquote {
        margin: 0 0 1.5em 0;
        padding: 1em 1.5em;
        border-left: 4px solid var(--accent);
        background-color: rgba(128, 128, 128, 0.03);
        border-radius: 0 8px 8px 0;
        font-style: italic;
        color: var(--muted);
      }

      hr {
        border: 0;
        height: 1px;
        background: var(--border);
        margin: 3em 0;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1.5em;
        font-family: var(--font-sans);
        font-size: 0.95em;
      }

      th, td {
        border: 1px solid var(--border);
        padding: 0.75em 1em;
        text-align: left;
      }

      th {
        background-color: rgba(128, 128, 128, 0.03);
        font-weight: 600;
      }
      
      .abstract {
        font-family: var(--font-sans);
        background: rgba(128,128,128,0.03);
        border: 1px solid var(--border);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        padding: 2rem;
        border-radius: 12px;
        margin: 2rem 0;
        font-size: 1rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
      }
      
      .abstract h2 {
        margin-top: 0;
        border-bottom: none;
        font-size: 1.25rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
      }

      img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        border: 1px solid var(--border);
      }
    </style>
  </head>
  <body>
    <main>
      <article>
        <slot />
      </article>
      <footer
        style="margin-top:3rem;padding-top:1rem;border-top:1px solid rgba(128,128,128,.25);font-size:.85em;opacity:.75;"
      >
        <a href="https://fabriziosalmi.github.io/privacy">Privacy &amp; legal notice</a>
        &nbsp;&middot;&nbsp; Published by Fabrizio Salmi
      </footer>
    </main>
  </body>
</html>
